[Unit]
Description=Stock Analysis FastAPI Backend
After=network.target mysql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/gupaio/backend
EnvironmentFile=/opt/gupaio/backend/.env
ExecStart=/opt/gupaio/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
